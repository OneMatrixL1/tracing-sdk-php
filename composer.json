{
    "name": "onematrix/tracing-sdk",
    "description": "Tracing SDK: canonicalize (RFC 8785 JSON Canonicalization Scheme, or W3C C14N for XML) and hash (Keccak-256) data-integrity records, then send them to an Indexer service over HTTP.",
    "type": "library",
    "license": "MIT",
    "author": {
        "name": "1Matrix",
        "email": "anhtd@1matrix.com"
    },
    "require": {
        "php": "^7.1 || ^8.0",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "kornrunner/keccak": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Tracing\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tracing\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
